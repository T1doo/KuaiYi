<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <ApplicationManifest>../../src/KuaiYi.Windows/app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>false</SelfContained>
  </PropertyGroup>
  <PropertyGroup><KuaiYiVisualProductRoot Condition="'$(KuaiYiVisualProductRoot)' == ''">$(MSBuildThisFileDirectory)../..</KuaiYiVisualProductRoot></PropertyGroup>
  <ItemGroup><ProjectReference Include="$(KuaiYiVisualProductRoot)/src/KuaiYi.Windows/KuaiYi.Windows.csproj" /><ProjectReference Include="$(KuaiYiVisualProductRoot)/src/KuaiYi.App/KuaiYi.App.csproj" /></ItemGroup>
</Project>
