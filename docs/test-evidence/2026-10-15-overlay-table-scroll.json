  "Implementation": {
    "NativeTable": "BlockUIContainer -> read-only RichTextBox -> FlowDocument -> original native Table/RowGroup/Row/Cell/Run/Span; header/alignment/inline semantics retained",
    "LocalViewport": "HVisible/VVisible, no Undo/Drop, IsDocumentEnabled false, current font/foreground, clipped; same finite width in body and measurement",
    "Dimensions": {
      "LocalWidth": "max(1, shared body width - SystemParameters.VerticalScrollBarWidth)",
      "LocalMaximumHeight": "min(320 DIP, shared maximum body height)",
      "ColumnWidth": "clamp(8 + min(512, longest displayed cell UTF16 length) * fontSize * .65, 96, 480) DIP",
      "InternalPageWidth": "min(8192, max(local available width, sum of columns + CellSpacing*(count+1)))",
      "WidthPolicy": "Deterministic estimate, not actual font measurement",
      "OuterPage": "Existing finite PageWidth/ColumnWidth; unchanged code/prose paths"
    },
    "Incremental": "Same version, Source append, compatible alignments and row count reuse Table/view/cells; update changed paragraphs and append rows only",
    "Selection": "Retained cell row/column plus cell-local symbol offsets normalized inside first/last insertion positions; excludes moving table/row/run/paragraph closing symbols; coalesced snapshot and latest guarded Loaded restore",
    "RestoreGuards": [
      "Region revision",
      "Global reader-intent epoch",
      "resultRevision",
      "Session lock",
      "Exit",
      "Dispose"
    ],
    "ReaderIntent": "Reuse existing code-reader pause callback for table wheel/left/drag/touch/navigation/Ctrl+A/scrollbar input; outer bottom does not resume; explicit follow/new result reset",
    "Cleanup": "Detach all handlers, invalidate callbacks, clear nested document/table rows and columns, release model, clear selection and offsets on replacement/fallback/clear",
    "RawCopy": "Original OverlayResults.Text retained; actual OS clipboard NotRun",
